<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="Root" RequestedTheme="Dark" Background="#202B30">
  <Grid.Resources>
    <SolidColorBrush x:Key="Ink" Color="#EDF2ED" />
    <SolidColorBrush x:Key="Muted" Color="#B2C0C0" />
    <SolidColorBrush x:Key="Mint" Color="#BEDFC7" />
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Georgia" />
      <Setter Property="FontSize" Value="36" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <Border x:Name="TitleBar" Background="#202B30" Height="32" />

  <Grid x:Name="StartupPanel" Grid.Row="1">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" Margin="28">
      <TextBlock Text="◴ Tasks" FontFamily="Georgia" FontSize="40" Foreground="{StaticResource Ink}" />
      <ProgressBar IsIndeterminate="True" Width="240" Height="3" Foreground="{StaticResource Mint}" />
      <TextBlock Text="Restoring your session…" Foreground="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
  </Grid>

  <ScrollViewer x:Name="SignInPanel" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
    <StackPanel Width="390" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,64" Spacing="18">
      <TextBlock Text="◴ Tasks" FontFamily="Georgia" FontSize="40" Foreground="{StaticResource Ink}" />
      <TextBlock Text="Connect to your workspace" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,0" />
      <TextBlock Text="Sign in with your Tasks server account. Task data stays on your server." TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
      <TextBox x:Name="ServerUrl" Header="Server URL" PlaceholderText="https://your-server" InputScope="Url" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" MaxLength="2048" />
      <TextBox x:Name="Username" Header="Username" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" MaxLength="64" />
      <PasswordBox x:Name="Password" Header="Password" MaxLength="1024" PasswordRevealMode="Peek" />
      <Button x:Name="SignIn" Content="Sign in" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{StaticResource Mint}" Foreground="#1F392B" FontWeight="SemiBold" Padding="16,11" />
      <TextBlock Text="First time? Create the first account in your server’s web welcome screen, or ask your server administrator." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
      <TextBlock x:Name="DevelopmentWarning" Text="Local development: HTTP is unencrypted. Only loopback HTTP is allowed; production servers require HTTPS." TextWrapping="Wrap" Foreground="#E3C69A" Visibility="Collapsed" FontSize="12" />
    </StackPanel>
  </ScrollViewer>

  <Grid x:Name="ConnectionPanel" Grid.Row="1" Visibility="Collapsed">
    <StackPanel MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" Margin="28">
      <TextBlock Text="Connection required" Style="{StaticResource Heading}" />
      <TextBlock Text="Reconnect to access your tasks. No task data is stored on this device." Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
      <TextBlock x:Name="OfflineEndpoint" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="RetryConnection" Content="Reconnect" /><Button x:Name="OfflineSignOut" Content="Sign out" /></StackPanel>
    </StackPanel>
  </Grid>

  <Grid x:Name="Workspace" Grid.Row="1" Visibility="Collapsed">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarWidth" Width="204" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Grid Background="#192328" Padding="12,30,12,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <TextBlock Text="◴ Tasks" FontFamily="Georgia" FontSize="29" Margin="12,0,0,32" Foreground="{StaticResource Ink}" />
      <StackPanel Grid.Row="1" Spacing="5">
        <Button x:Name="TodayNav" Style="{StaticResource NavButton}" AutomationProperties.Name="Today"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE706;" FontSize="18" /><TextBlock Text="Today" VerticalAlignment="Center" /></StackPanel></Button>
        <Button x:Name="UpcomingNav" Style="{StaticResource NavButton}" AutomationProperties.Name="Upcoming"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE787;" FontSize="18" /><TextBlock Text="Upcoming" VerticalAlignment="Center" /></StackPanel></Button>
        <Button x:Name="RoutinesNav" Style="{StaticResource NavButton}" AutomationProperties.Name="Routines"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8EE;" FontSize="18" /><TextBlock Text="Routines" VerticalAlignment="Center" /></StackPanel></Button>
      </StackPanel>
      <Button x:Name="SettingsNav" Grid.Row="3" Style="{StaticResource NavButton}" AutomationProperties.Name="Settings"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE713;" FontSize="18" /><TextBlock Text="Settings" VerticalAlignment="Center" /></StackPanel></Button>
    </Grid>
    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="MainContent" MaxWidth="1000" HorizontalAlignment="Left" Padding="40,32,40,32" Spacing="26">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Spacing="6"><TextBlock x:Name="PageTitle" Text="Today" Style="{StaticResource Heading}" /><TextBlock x:Name="PageSubtitle" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" /></StackPanel>
          <Button x:Name="AddTask" Grid.Column="1" Content="＋  Add task" VerticalAlignment="Center" Margin="24,0,0,0" Padding="14,9" />
        </Grid>
        <StackPanel x:Name="TodayPanel" Spacing="26">
          <StackPanel Spacing="10"><Grid><TextBlock Text="Daily progress" FontSize="12" /><TextBlock x:Name="ProgressText" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource Muted}" /></Grid><ProgressBar x:Name="DailyProgress" Height="5" Minimum="0" Maximum="1" Value="0" Foreground="{StaticResource Mint}" Background="#3B4B50" /></StackPanel>
          <Border x:Name="CurrentCard" Background="#30453E" BorderBrush="#4B6656" BorderThickness="1" CornerRadius="8" Padding="26,22,26,24" MinHeight="283">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid Margin="0,0,0,18"><TextBlock Text="Current task" CharacterSpacing="100" FontSize="12" FontWeight="SemiBold" Foreground="#C1D8C6" VerticalAlignment="Center" /><Button x:Name="CurrentOptions" HorizontalAlignment="Right" Content="⋯" FontSize="22" Padding="7,0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Current task options"><Button.Flyout><MenuFlyout><MenuFlyoutItem x:Name="NotNow" Text="Not now" /></MenuFlyout></Button.Flyout></Button></Grid>
              <Button x:Name="CurrentTitleActions" Grid.Row="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0" Background="Transparent" BorderThickness="0" IsTabStop="True" Margin="0,0,0,13">
                <TextBlock x:Name="CurrentTitle" FontFamily="Georgia" FontSize="32" TextWrapping="Wrap" Foreground="#EAF3E9" />
              </Button>
              <TextBlock x:Name="CurrentMetadata" Grid.Row="2" FontSize="12" Foreground="#C1D8C6" TextWrapping="Wrap" />

              <Button x:Name="MarkDone" Grid.Row="4" HorizontalAlignment="Right" Content="✓  Mark done" Background="{StaticResource Mint}" Foreground="#1F392B" FontWeight="SemiBold" Padding="16,10" Margin="0,16,0,0" />
            </Grid>
          </Border>
          <StackPanel Spacing="12"><Grid><TextBlock Text="Waiting for you" FontSize="12" FontWeight="SemiBold" CharacterSpacing="80" Foreground="{StaticResource Muted}" /><TextBlock x:Name="QueueCount" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource Muted}" /></Grid><StackPanel x:Name="QueueList" /></StackPanel>
          <StackPanel x:Name="CompletedPanel" Spacing="12"><Button x:Name="CompletedToggle" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Muted}" AutomationProperties.Name="Completed today, collapsed" /><StackPanel x:Name="CompletedList" /></StackPanel>
        </StackPanel>
        <StackPanel x:Name="ListPanel" Spacing="12" Visibility="Collapsed" />
        <StackPanel x:Name="TaskDetailsPanel" Spacing="20" Visibility="Collapsed" />
        <StackPanel x:Name="TaskEditorPanel" Spacing="18" Visibility="Collapsed" />
        <StackPanel x:Name="SettingsPanel" Spacing="18" Visibility="Collapsed">
          <TextBlock Text="Connection" FontSize="20" FontWeight="SemiBold" />
          <TextBlock x:Name="ConnectionDetails" TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
          <TextBlock Text="Your session is protected for this Windows user. Passwords and task data are never saved on this device." TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
          <StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="Refresh" Content="Test connection" /><Button x:Name="SignOut" Content="Sign out" /></StackPanel>
          <TextBlock Text="To change server or account, sign out first." Foreground="{StaticResource Muted}" FontSize="12" />
          <Border Background="#26353A" BorderBrush="#3B4B50" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,10,0,0">
            <StackPanel Spacing="14">
              <TextBlock Text="Version &amp; updates" FontSize="20" FontWeight="SemiBold" />
              <TextBlock x:Name="InstalledVersion" Foreground="{StaticResource Muted}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
              <TextBlock x:Name="UpdateStatus" Text="Check for Windows updates when you choose." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
              <ProgressBar x:Name="UpdateProgress" IsIndeterminate="True" Visibility="Collapsed" Height="3" Foreground="{StaticResource Mint}" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="CheckUpdates" Content="Check for updates" />
                <Button x:Name="DownloadUpdate" Content="Download update" Visibility="Collapsed" Background="{StaticResource Mint}" Foreground="#1F392B" />
                <Button x:Name="RestartUpdate" Content="Restart and install" Visibility="Collapsed" />
              </StackPanel>
              <TextBlock x:Name="LastUpdateCheck" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
              <TextBlock Text="Download updates here, then choose Restart and install. No background download or automatic installation. Finish any task edits before restarting." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
              <Expander x:Name="ReleaseNotesPanel" Header="Release notes" Visibility="Collapsed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <TextBlock x:Name="ReleaseNotes" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{StaticResource Muted}" />
                </ScrollViewer>
              </Expander>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
  <StackPanel Grid.Row="2" Background="#192328" Padding="20,10" Spacing="6">
    <ProgressBar x:Name="BusyProgress" IsIndeterminate="True" Visibility="Collapsed" Height="3" Foreground="{StaticResource Mint}" />
    <TextBlock x:Name="Notice" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" />
  </StackPanel>
</Grid>
